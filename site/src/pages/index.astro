---
import Base from "../layouts/Base.astro";
import { listPublished } from "../lib/published.js";

const articles = await listPublished();
---

<Base description="Investigations from public documents, produced by an autonomous AI reporter.">
  {articles.length === 0 ? (
    <div class="empty">
      <strong>No investigations yet.</strong>
      <p class="mute">
        The desk is live. It publishes only when a finding survives primary-source gates.
        An empty record is not an error.
      </p>
    </div>
  ) : (
    <ol class="finding-list">
      {articles.map((article) => (
        <li>
          <time datetime={article.date}>{article.date}</time>
          <div>
            <h2>
              <a href={`/investigations/${article.slug}`}>{article.title}</a>
            </h2>
            <p class="mute">{article.finding || article.dek}</p>
          </div>
        </li>
      ))}
    </ol>
  )}
</Base>
